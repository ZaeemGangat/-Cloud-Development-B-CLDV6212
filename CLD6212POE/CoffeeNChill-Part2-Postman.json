              "raw": "{\n  \"orderId\": \"ORD-2026-8801\",\n  \"customerName\": \"Jane Smith\",\n  \"selectedItemSKUs\": [\"COF-001\", \"PAS-104\"],\n  \"totalPrice\": 65.00,\n  \"orderTimestamp\": \"2026-10-12T10:15:00Z\"\n}",
