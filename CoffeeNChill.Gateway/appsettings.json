{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "UsersTableName": "Users",
    "MenuTableName": "MenuItems",
    "OrdersTableName": "Orders",
    "DocumentsContainerName": "staff-docs",
    "OrderQueueName": "orderprocessingqueue"
  },

  "Jwt": {
    "Issuer": "CoffeeNChill.Gateway",
    "Audience": "CoffeeNChill.Clients",
    "Key": "",
    "ExpiryMinutes": 60
  },

  "SeedAdmin": {
    "Email": "",
    "Password": "",
    "FullName": "Canteen Manager"
  },

  "Swagger": {
    "Enabled": true
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "RateLimiting": {
    "AuthPermitLimitPerMinute": 10
  }
}
