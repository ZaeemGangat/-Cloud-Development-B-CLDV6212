{
  "info": {
    "_postman_id": "80efd810-da9d-40a3-af76-a399e5d65c41",
    "name": "CoffeeNChill Part 3 - API Gateway (JWT)",
    "description": "Tests every CoffeeNChill gateway endpoint, including the JWT Bearer flows and role-based access (Admin, Staff, Customer, anonymous).\n\nRun the folders in order (Collection Runner). Set baseUrl to http://localhost:5000 for local runs, or to the VPS URL (http://<vps-ip>:5000).\n\nRequests inherit the collection auth: Authorization: Bearer {{token}}. The login requests set {{token}} automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Healthy\", () => pm.expect(pm.response.json().status).to.eql(\"Healthy\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login as Admin (seed manager)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Logs in the seed Admin created on startup. Stores the JWT in {{adminToken}} and {{token}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Response contains a JWT\", () => pm.expect(body.token.split(\".\")).to.have.lengthOf(3));",
                  "pm.test(\"Role is Admin\", () => pm.expect(body.user.role).to.eql(\"Admin\"));",
                  "pm.collectionVariables.set(\"adminToken\", body.token);",
                  "pm.collectionVariables.set(\"token\", body.token); // used by every request that inherits Bearer {{token}}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Staff (barista) - as Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{staffEmail}}\",\n  \"password\": \"{{staffPassword}}\",\n  \"fullName\": \"Thandi Barista\",\n  \"role\": \"Staff\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Only an Admin token may create Staff/Admin accounts. 409 means the barista already exists (re-run)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 or 409\", () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) pm.test(\"Created as Staff\", () => pm.expect(pm.response.json().role).to.eql(\"Staff\"));",
                  "pm.test(\"Password hash is never returned\", () => pm.expect(pm.response.text()).to.not.include(\"passwordHash\"));"
                ]
              }
            }
          ]
        },
