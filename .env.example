# Copy to .env on the VPS (next to docker-compose.yml) and fill in.
# NEVER commit the real .env - it is in .gitignore.

# Docker Hub account that hosts the images, and which tag to run.
# The CI/CD pipeline updates TAG automatically on each deployment.
DOCKERHUB_USERNAME=glitchysheep78
TAG=v3.0

# Public port for the gateway (Swagger at http://<vps-ip>:5000/swagger)
GATEWAY_PORT=5000

# JWT signing key - at least 32 random characters. Generate one with:
#   openssl rand -base64 48
JWT_KEY=
JWT_EXPIRY_MINUTES=60

# First Admin (canteen manager) account, created on first start.
SEED_ADMIN_EMAIL=manager@coffeenchill.ac.za
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Canteen Manager

# Set to false to hide Swagger UI after the video is recorded.
SWAGGER_ENABLED=true

# Seconds between Received → Preparing → Ready in the queue processor.
ORDER_STEP_DELAY_SECONDS=5

# Optional: use a real Azure Storage account instead of the Azurite container.
# STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
